@page
@model Hrs.Fiscal.Server.Pages.FlipMessages.IndexModel
@{
    ViewData["Title"] = "FLIP messages";
}
<div class="page-head">
    <div>
        <h1>FLIP messages</h1>
        <p>Everything OPERA sends through FLIP, stored exactly as received, with the fiscal server's answer.</p>
    </div>
    <a class="btn" href="/FlipMessages">Refresh</a>
</div>

@if (Model.Mode == "capture")
{
    <div class="notice warn"><strong>Capture mode.</strong> Messages are recorded but not fiscalized. The fiscal server answers every message with the test answer set under <a href="/Settings">Settings › General</a> (now HTTP @Model.Stub.Status@(string.IsNullOrEmpty(Model.Stub.Body) ? ", empty body" : "")).</div>
}
else
{
    <div class="notice"><strong>Live mode.</strong> OPERA folios are fiscalized: signed for the workstation of the OPERA terminal, archived, sent to ATK, and the fiscal server answers FLIP with the fiscal data (receipt no., NUIKF, QR). Other requests (connection tests) get a plain OK.</div>
}

<section class="card">
    <h2>Where FLIP should send to</h2>
    <div class="kv">
        <div>HTTP address</div><div class="mono">@foreach (var u in Model.FlipUrls(HttpContext.Connection.LocalPort)) { <div>@u</div> }<div class="small muted" style="font-family: inherit">Use the IP address, not the computer name. Any path below /flip is accepted; a URL without /flip is not recorded.</div></div>
        <div>Raw TCP</div><div class="mono">@(Model.TcpPort > 0 ? $"port {Model.TcpPort}" : "off (set Flip:TcpPort in appsettings.json to enable)")</div>
    </div>
    <p class="small muted" style="margin: 12px 0 0">Enter one of these as the EndPoint Url in FLIP's partner configuration (port 5080 is only for this admin page). Messages appear here within a second.</p>
</section>

<section class="card">
    <h2>Received (@Model.Messages.Count)</h2>
    @if (Model.Messages.Count == 0)
    {
        <p class="muted" style="margin: 0">Nothing received yet. Generate a folio in OPERA once FLIP points to this server.</p>
    }
    else
    {
        <p class="small muted" style="margin: 0 0 8px">Newest first. Click a message to see its details.</p>
        <div class="msg-list">
        @foreach (var m in Model.Messages)
        {
            var ok = m.ResponseStatus is >= 200 and < 300;
            <details class="msg" id="m@(m.Id)" open="@(Model.Id == m.Id)">
                <summary>
                    <span class="msg-id mono">#@m.Id</span>
                    <span class="mono">@Model.Clock.Format(m.ReceivedAt)</span>
                    <span class="mono">@(m.Transport == "tcp" ? "TCP" : $"{m.Method} {m.Path}")</span>
                    <span class="mono muted">@m.RemoteAddress</span>
                    <span class="badge neutral">@m.Kind</span>
                    <span class="mono muted">@m.Size.ToString("N0") B</span>
                    <span class="badge @(m.Mode == "rejected" ? "rejected" : ok ? "accepted" : m.ResponseStatus is null ? "neutral" : "rejected")">@(m.Mode == "rejected" ? "refused (token)" : $"HTTP {m.ResponseStatus?.ToString() ?? "—"}")</span>
                    <span>@if (m.ReceiptId is not null) { <span class="badge accepted">receipt</span> }</span>
                </summary>
                <div class="msg-body">
                    <div class="kv">
                        <div>Received</div><div>@Model.Clock.Format(m.ReceivedAt)</div>
                        <div>From</div><div class="mono">@m.RemoteAddress</div>
                        <div>Request</div><div class="mono">@(m.Transport == "tcp" ? "raw TCP" : $"{m.Method} {m.Path}")</div>
                        <div>Content type</div><div class="mono">@(m.ContentType ?? "—")</div>
                        <div>Our answer</div><div class="mono">HTTP @(m.ResponseStatus?.ToString() ?? "—")</div>
                        @if (m.ReceiptId is { } rid) { <div>Receipt</div><div><a href="/Receipts/Detail/@rid">Open the fiscal receipt</a></div> }
                    </div>
                    @if (!string.IsNullOrEmpty(m.ResponseBody))
                    {
                        <details>
                            <summary>Our answer to FLIP <span class="muted small">(@m.ResponseBody.Length.ToString("N0") characters)</span></summary>
                            <pre class="payload">@Model.Pretty(m.ResponseBody)</pre>
                        </details>
                    }
                    <details>
                        <summary>Headers</summary>
                        <pre class="payload">@m.Headers</pre>
                    </details>
                    <details>
                        <summary>Body from OPERA <span class="muted small">(@m.Kind, @m.Size.ToString("N0") bytes)</span></summary>
                        <pre class="payload" style="max-height: 560px">@m.Pretty()</pre>
                    </details>
                    <div><a class="btn small" href="/flip-messages/@m.Id/raw">Download raw</a></div>
                </div>
            </details>
        }
        </div>
    }
</section>
