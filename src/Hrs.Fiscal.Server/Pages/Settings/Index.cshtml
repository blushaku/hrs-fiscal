@page
@model Hrs.Fiscal.Server.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
    var c = Model.Current;
    string Title(string s) => Hrs.Fiscal.Server.Pages.Settings.IndexModel.Sections[s].Title;
    string OrNone(string? v) => string.IsNullOrWhiteSpace(v) ? "not set" : v;
}
<div class="page-head"><div><h1>Settings</h1></div></div>
<partial name="_SettingsNav" />

@* Tiles show the essentials. Edit opens the full editor in a pop-up; Save asks for confirmation and lists the changes. *@
@functions {
    private Microsoft.AspNetCore.Html.IHtmlContent EditButton(string section) => new Microsoft.AspNetCore.Html.HtmlString(
        $"<a class=\"btn small\" href=\"/Settings?Edit={section}\" data-dialog-open=\"dlg-{section}\">Edit</a>");
    private Microsoft.AspNetCore.Html.IHtmlContent ModalHead(string section, string title) => new Microsoft.AspNetCore.Html.HtmlString(
        $"<div class=\"modal-head\"><h2 id=\"dlg-{section}-title\">{System.Net.WebUtility.HtmlEncode(title)}</h2>" +
        "<button type=\"button\" class=\"modal-close\" data-dialog-close data-return=\"/Settings\" aria-label=\"Close\">×</button></div>");
}

<div class="tile-grid">
    <section class="card" id="atk">
        <h2>ATK connection</h2>
        <dl class="kv">
            <dt>Environment</dt><dd>@(c.AtkEnvironment == "Production" ? "Production" : "Test")</dd>
            <dt>Application ID</dt><dd class="mono">@(c.AtkApplicationId > 0 ? c.AtkApplicationId.ToString() : "not set")</dd>
        </dl>
        <div class="tile-foot">@EditButton("atk")</div>
    </section>

    <section class="card" id="flip">
        <h2>OPERA / FLIP</h2>
        <dl class="kv">
            <dt>Mode</dt><dd>@(c.FlipMode == "live" ? "Live" : "Capture")</dd>
            <dt>Access token</dt><dd>@(Model.Token.HasToken ? (c.FlipAuthRequired ? "required" : "set, not required") : "none")</dd>
        </dl>
        <div class="tile-foot">@EditButton("flip") <a class="btn small" href="/Settings?Edit=token" data-dialog-open="dlg-token">Token</a></div>
    </section>

    <section class="card" id="signing">
        <h2>Signing</h2>
        <dl class="kv"><dt>Mode</dt><dd>@(c.SigningModeDefault == "server" ? "Central (server)" : "Workstation client")</dd></dl>
        <div class="tile-foot">@EditButton("signing")</div>
    </section>

    <section class="card" id="overrides">
        <h2>Receipt defaults</h2>
        <dl class="kv">
            <dt>OPERA overrides</dt><dd>@(c.OperaOverridesEnabled ? "on" : "off")</dd>
            <dt>Category, unit</dt><dd>@c.DefaultItemCategory, @c.DefaultItemUnit</dd>
        </dl>
        <div class="tile-foot">@EditButton("overrides")</div>
    </section>

    <section class="card" id="vat">
        <h2>VAT calculation</h2>
        <dl class="kv"><dt>Rounding</dt><dd>@(c.VatRounding == "TruncateNet" ? "Truncate net" : "Round VAT half-up")</dd></dl>
        <div class="tile-foot">@EditButton("vat")</div>
    </section>

    <section class="card" id="retention">
        <h2>Retention and backup</h2>
        <dl class="kv"><dt>Keep for</dt><dd>@c.RetentionYears years</dd><dt>Backup</dt><dd>@OrNone(c.BackupTarget)</dd></dl>
        <div class="tile-foot">@EditButton("retention")</div>
    </section>

    <section class="card" id="alerts">
        <h2>Alerts</h2>
        <dl class="kv"><dt>Send to</dt><dd>@OrNone(c.AlertEmails)</dd></dl>
        <div class="tile-foot">@EditButton("alerts")</div>
    </section>
</div>

@if (Model.NewToken is { } tok)
{
    <div class="notice warn" style="display: flex; flex-direction: column; gap: 6px">
        <strong>Copy this FLIP access token into FLIP's partner configuration now. It is not shown again.</strong>
        <code class="mono" style="word-break: break-all; user-select: all; font-size: 14px" id="flip-token">@tok</code>
        <span class="small">FLIP sends it as <span class="mono">@Model.Token.Header: Bearer &lt;token&gt;</span> (the bare token is accepted too).</span>
    </div>
}

@* ======================= editors ======================= *@

<dialog class="modal" id="dlg-atk" aria-labelledby="dlg-atk-title" data-autoopen="@(Model.Edit == "atk" ? "1" : null)" open="@(Model.Edit == "atk")">
    @ModalHead("atk", Title("atk"))
    <form method="post" class="modal-body" data-confirm="Save these ATK connection settings?">
        <input type="hidden" name="section" value="atk">
        <div asp-validation-summary="All" class="validation"></div>
        <label class="field">Environment
            <select asp-for="Input.AtkEnvironment">
                <option value="Test">Test (fiskalizimi-test.atk-ks.org)</option>
                <option value="Production">Production (fiskalizimi.atk-ks.org)</option>
            </select>
        </label>
        <label class="field">Application ID (issued by ATK on certification) <input type="number" asp-for="Input.AtkApplicationId" min="0"></label>
        <div class="form-grid">
            <label class="field">Timeout (seconds) <input type="number" asp-for="Input.AtkTimeoutSeconds" min="2" max="60"></label>
            <label class="field">Retry offline queue every (minutes) <input type="number" asp-for="Input.AtkRetryMinutes" min="1" max="60"></label>
        </div>
        <p class="small muted">Never send test receipts to Production. Switch only for go-live.</p>
        <partial name="_ConfirmBox" model="@("Yes, save")" />
        <div class="actions" data-hide-on-confirm><button type="submit" class="btn primary">Save</button><button type="button" class="btn" data-dialog-close data-return="/Settings">Cancel</button></div>
    </form>
</dialog>

<dialog class="modal" id="dlg-flip" aria-labelledby="dlg-flip-title" data-autoopen="@(Model.Edit == "flip" ? "1" : null)" open="@(Model.Edit == "flip")">
    @ModalHead("flip", Title("flip"))
    <form method="post" class="modal-body" data-confirm="Save the OPERA / FLIP connection settings?">
        <input type="hidden" name="section" value="flip">
        <div asp-validation-summary="All" class="validation"></div>
        <label class="field">Mode
            <select asp-for="Input.FlipMode">
                <option value="capture">Capture: record what FLIP sends, answer with a test reply</option>
                <option value="live">Live: fiscalize OPERA folios</option>
            </select>
        </label>
        <div class="form-grid">
            <label class="field">Test reply: HTTP status <input type="number" asp-for="Input.FlipStubStatus" min="100" max="599"></label>
            <label class="field">Test reply: content type <input type="text" asp-for="Input.FlipStubContentType" placeholder="text/plain"></label>
        </div>
        <label class="field">Test reply: body <textarea asp-for="Input.FlipStubBody" rows="3" placeholder="Empty, or a sample answer to see how OPERA reacts"></textarea></label>
        <p class="small muted">The test reply is used in capture mode only. Messages are listed under <a href="/FlipMessages">FLIP messages</a>.</p>
        <partial name="_ConfirmBox" model="@("Yes, save")" />
        <div class="actions" data-hide-on-confirm><button type="submit" class="btn primary">Save</button><button type="button" class="btn" data-dialog-close data-return="/Settings">Cancel</button></div>
    </form>
</dialog>

<dialog class="modal" id="dlg-token" aria-labelledby="dlg-token-title" data-autoopen="@(Model.Edit == "token" ? "1" : null)" open="@(Model.Edit == "token")">
    @ModalHead("token", Title("token"))
    <form method="post" class="modal-body" data-confirm="Save the FLIP token settings?">
        <input type="hidden" name="section" value="token">
        <div asp-validation-summary="All" class="validation"></div>
        <p>@if (Model.Token.HasToken) { <span>Current token ends in <span class="mono">…@Model.Token.Hint</span>, created @(Model.Token.CreatedUtc is { } cu ? Model.Clock.ToLocal(cu).ToString("dd.MM.yyyy HH:mm") : "").</span> } else { <span class="muted">No token yet: FLIP requests are accepted from the allowed IP without a token.</span> }</p>
        <label class="check"><input type="checkbox" asp-for="Input.FlipAuthRequired"> Require the token (requests without it get 401)</label>
        <label class="field">Header that carries the token <input type="text" asp-for="Input.FlipAuthHeader" placeholder="Authorization"></label>
        <partial name="_ConfirmBox" model="@("Yes, save")" />
        <div class="actions" data-hide-on-confirm><button type="submit" class="btn primary">Save</button><button type="button" class="btn" data-dialog-close data-return="/Settings">Cancel</button></div>
    </form>
    <form method="post" asp-page-handler="GenerateToken" class="modal-body" style="border-top: 1px solid var(--line)" data-confirm="Generate a new token? The current one stops working at once, so FLIP must be updated straight away." data-new>
        <p class="small muted">Only a hash is stored. The new token is shown once after it is generated.</p>
        <partial name="_ConfirmBox" model="@("Yes, generate")" />
        <div class="actions" data-hide-on-confirm><button type="submit" class="btn">@(Model.Token.HasToken ? "Generate new token" : "Generate token")</button></div>
    </form>
</dialog>

<dialog class="modal" id="dlg-signing" aria-labelledby="dlg-signing-title" data-autoopen="@(Model.Edit == "signing" ? "1" : null)" open="@(Model.Edit == "signing")">
    @ModalHead("signing", Title("signing"))
    <form method="post" class="modal-body" data-confirm="Change where receipts are signed? Affected workstations must then be registered with ATK again.">
        <input type="hidden" name="section" value="signing">
        <label class="field">Where receipts are signed
            <select asp-for="Input.SigningModeDefault">
                <option value="client">Workstation client (HRS Fiscal Client on each PC)</option>
                <option value="server">Central (server, one key per workstation)</option>
            </select>
        </label>
        <p class="small muted">Either way every workstation is its own ATK POS with its own certificate. Central mode needs nothing installed on the workstations but is pending ATK's confirmation. A single workstation can use the other mode (Workstations).</p>
        <partial name="_ConfirmBox" model="@("Yes, save")" />
        <div class="actions" data-hide-on-confirm><button type="submit" class="btn primary">Save</button><button type="button" class="btn" data-dialog-close data-return="/Settings">Cancel</button></div>
    </form>
</dialog>

<dialog class="modal" id="dlg-overrides" aria-labelledby="dlg-overrides-title" data-autoopen="@(Model.Edit == "overrides" ? "1" : null)" open="@(Model.Edit == "overrides")">
    @ModalHead("overrides", Title("overrides"))
    <form method="post" class="modal-body" data-confirm="Save the receipt defaults?">
        <input type="hidden" name="section" value="overrides">
        <div asp-validation-summary="All" class="validation"></div>
        <label class="check"><input type="checkbox" asp-for="Input.OperaOverridesEnabled"> Use overrides for transaction codes and payment methods</label>
        <div class="form-grid">
            <label class="field">Default ATK category <input type="text" asp-for="Input.DefaultItemCategory" maxlength="5" placeholder="TT"></label>
            <label class="field">Default unit <input type="text" asp-for="Input.DefaultItemUnit" maxlength="10" placeholder="cope"></label>
        </div>
        <p class="small muted">Off: receipts are fiscalized exactly as OPERA sends them. On: the entries under <a href="/Settings/Mapping">OPERA overrides &amp; VAT</a> replace OPERA's values for those codes. The defaults apply when OPERA and the overrides say nothing.</p>
        <partial name="_ConfirmBox" model="@("Yes, save")" />
        <div class="actions" data-hide-on-confirm><button type="submit" class="btn primary">Save</button><button type="button" class="btn" data-dialog-close data-return="/Settings">Cancel</button></div>
    </form>
</dialog>

<dialog class="modal" id="dlg-vat" aria-labelledby="dlg-vat-title" data-autoopen="@(Model.Edit == "vat" ? "1" : null)" open="@(Model.Edit == "vat")">
    @ModalHead("vat", Title("vat"))
    <form method="post" class="modal-body" data-confirm="Change the VAT rounding? It applies to receipts issued from now on.">
        <input type="hidden" name="section" value="vat">
        <label class="field">Rounding of VAT per rate
            <select asp-for="Input.VatRounding">
                <option value="RoundTaxHalfUp">Round VAT half-up (default)</option>
                <option value="TruncateNet">Truncate net amount (matches ATK sample code)</option>
            </select>
        </label>
        <p class="small muted">Pending ATK's official rule.</p>
        <partial name="_ConfirmBox" model="@("Yes, save")" />
        <div class="actions" data-hide-on-confirm><button type="submit" class="btn primary">Save</button><button type="button" class="btn" data-dialog-close data-return="/Settings">Cancel</button></div>
    </form>
</dialog>

<dialog class="modal" id="dlg-retention" aria-labelledby="dlg-retention-title" data-autoopen="@(Model.Edit == "retention" ? "1" : null)" open="@(Model.Edit == "retention")">
    @ModalHead("retention", Title("retention"))
    <form method="post" class="modal-body" data-confirm="Save the retention and backup settings?">
        <input type="hidden" name="section" value="retention">
        <div asp-validation-summary="All" class="validation"></div>
        <label class="field">Keep receipts and logs for (years) <input type="number" asp-for="Input.RetentionYears" min="1" max="50"></label>
        <label class="field">Daily backup target (folder or network share) <input type="text" asp-for="Input.BackupTarget" placeholder="\\NAS01\fiscal-backup"></label>
        <p class="small muted">The legal minimum is to be confirmed. Nothing is deleted automatically; after the period, records can only be moved to a signed archive by an administrator, and that is logged.</p>
        <partial name="_ConfirmBox" model="@("Yes, save")" />
        <div class="actions" data-hide-on-confirm><button type="submit" class="btn primary">Save</button><button type="button" class="btn" data-dialog-close data-return="/Settings">Cancel</button></div>
    </form>
</dialog>

<dialog class="modal" id="dlg-alerts" aria-labelledby="dlg-alerts-title" data-autoopen="@(Model.Edit == "alerts" ? "1" : null)" open="@(Model.Edit == "alerts")">
    @ModalHead("alerts", Title("alerts"))
    <form method="post" class="modal-body" data-confirm="Save the alert recipients?">
        <input type="hidden" name="section" value="alerts">
        <label class="field">Email alerts to (comma-separated) <input type="text" asp-for="Input.AlertEmails" placeholder="frontoffice@hotel.com, it@hotel.com"></label>
        <p class="small muted">Planned: alerts for waiting receipts, the 48-hour deadline, rejections, certificate expiry and failed backups.</p>
        <partial name="_ConfirmBox" model="@("Yes, save")" />
        <div class="actions" data-hide-on-confirm><button type="submit" class="btn primary">Save</button><button type="button" class="btn" data-dialog-close data-return="/Settings">Cancel</button></div>
    </form>
</dialog>
