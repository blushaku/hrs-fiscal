@page
@model Hrs.Fiscal.Server.Pages.Settings.BusinessModel
@{
    ViewData["Title"] = "Business & unit";
    var b = Model.Current;
    var firstSetup = b is null;
}
<partial name="_SettingsNav" />

@if (b is not null)
{
    <div class="tile-grid">
        <section class="card">
            <h2>Business (taxpayer)</h2>
            <dl class="kv">
                <dt>Name</dt><dd>@b.Name</dd>
                <dt>NUI</dt><dd class="mono">@b.Nui</dd>
                <dt>Fiscalization no.</dt><dd class="mono">@b.FiscalizationNo</dd>
                <dt>Name at ATK</dt>
                <dd>
                    @if (Model.AtkName is null) { <span class="muted">known after the first ATK registration</span> }
                    else if (Model.NameMatchesAtk) { <span class="badge accepted">matches</span> }
                    else { <span>@Model.AtkName</span> <span class="badge rejected">differs</span> }
                </dd>
            </dl>
            @if (!Model.NameMatchesAtk)
            {
                <form method="post" asp-page-handler="UseAtkName" class="atk-name" data-new="1" data-confirm="Change the business name to “@Model.AtkName”? It is printed on every receipt from now on.">
                    <p class="small muted" style="margin: 0">ATK has a different name (@Model.AtkNameSource). Receipts should carry the name ATK has registered.</p>
                    <partial name="_ConfirmBox" model="@("Yes, use ATK's name")" />
                    <div class="actions" data-hide-on-confirm><button type="submit" class="btn small">Use ATK's name</button></div>
                </form>
            }
            <div class="tile-foot"><a class="btn small" href="/Settings/Business?Edit=true" data-dialog-open="dlg-business">Edit</a></div>
        </section>
        <section class="card">
            <h2>Unit (business premises)</h2>
            <dl class="kv">
                <dt>Unit</dt><dd><span class="mono">@b.BranchId</span>, @b.BranchName</dd>
                <dt>City</dt><dd>@b.Location</dd>
                <dt>OPERA property</dt><dd class="mono">@(string.IsNullOrEmpty(b.OperaHotelCode) ? "not set" : b.OperaHotelCode)</dd>
            </dl>
            <div class="tile-foot"><a class="btn small" href="/Settings/Business?Edit=true" data-dialog-open="dlg-business">Edit</a></div>
        </section>
    </div>
}
else
{
    <section class="card" style="max-width: 640px; display: flex; flex-direction: column; gap: 12px">
        <h2 style="margin: 0">The property is not set up yet</h2>
        <p style="margin: 0">Enter the business and unit exactly as registered with ATK. NUI and unit number cannot be changed afterwards.</p>
        <div><a class="btn primary" href="/Settings/Business?Edit=true" data-dialog-open="dlg-business">Set up the business</a></div>
    </section>
}

<dialog class="modal wide" id="dlg-business" aria-labelledby="dlg-business-title" data-autoopen="@(Model.Editing ? "1" : null)" open="@Model.Editing">
    <div class="modal-head"><h2 id="dlg-business-title">@(firstSetup ? "Set up the business" : "Edit business and unit")</h2><button type="button" class="modal-close" data-dialog-close data-return="/Settings/Business" aria-label="Close">×</button></div>
    <form method="post" class="modal-body" data-confirm="@(firstSetup ? "Save the business? NUI and unit number cannot be changed afterwards." : "Save the business and unit details?")" data-new="@(firstSetup ? "1" : null)">
        <div asp-validation-summary="All" class="validation"></div>
        <h3 style="margin: 0; font-size: 15px; font-weight: 500">Business (taxpayer)</h3>
        <div class="form-grid">
            <label class="field">NUI (fiscal number) <input type="number" asp-for="Input.Nui" readonly="@Model.Locked"></label>
            <label class="field">Registered name <input type="text" asp-for="Input.Name"></label>
            <label class="field">VAT number <input type="text" asp-for="Input.VatNo"></label>
            <label class="field">Fiscalization no. (from EDI) <input type="text" asp-for="Input.FiscalizationNo"></label>
        </div>
        <h3 style="margin: 0; font-size: 15px; font-weight: 500">Unit (business premises)</h3>
        <div class="form-grid">
            <label class="field">Unit number registered with ATK <input type="number" asp-for="Input.BranchId" readonly="@Model.Locked"></label>
            <label class="field">Unit name <input type="text" asp-for="Input.BranchName"></label>
            <label class="field">City / location (printed) <input type="text" asp-for="Input.Location"></label>
            <label class="field">Address <input type="text" asp-for="Input.Address"></label>
            <label class="field">OPERA property code <input type="text" asp-for="Input.OperaHotelCode"></label>
        </div>
        <p class="small muted">@(Model.Locked ? "NUI and unit number are locked: they are part of every receipt number, certificate and SEF ID." : "Check NUI and unit number against the ATK registration: they cannot be changed after saving.")</p>
        <partial name="_ConfirmBox" model="@("Yes, save")" />
        <div class="actions" data-hide-on-confirm><button type="submit" class="btn primary">Save</button><button type="button" class="btn" data-dialog-close data-return="/Settings/Business">Cancel</button></div>
    </form>
</dialog>
