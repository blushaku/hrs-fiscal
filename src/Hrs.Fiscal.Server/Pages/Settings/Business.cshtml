@page
@model Hrs.Fiscal.Server.Pages.Settings.BusinessModel
@{
    ViewData["Title"] = "Business & unit";
    var b = Model.Current;
    var firstSetup = b is null;
}
<partial name="_SettingsNav" />

@if (b is not null)
{
    <div class="tile-grid">
        <section class="card">
            <h2>Business (taxpayer)</h2>
            <dl class="kv">
                <dt>Name</dt><dd>@b.Name</dd>
                <dt>NUI</dt><dd class="mono">@b.Nui</dd>
                <dt>VAT no.</dt><dd class="mono">@(string.IsNullOrEmpty(b.VatNo) ? "not set" : b.VatNo)</dd>
                <dt>Fiscalization no.</dt><dd class="mono">@b.FiscalizationNo</dd>
                <dt>Application ID</dt><dd class="mono">@(Model.ApplicationId > 0 ? Model.ApplicationId.ToString() : "not set")</dd>
                <dt>Name at ATK</dt>
                <dd>
                    @if (Model.AtkName is null) { <span class="muted">known after the first ATK registration</span> }
                    else if (Model.NameMatchesAtk) { <span class="badge accepted">matches</span> }
                    else { <span>@Model.AtkName</span> <span class="badge rejected">differs</span> }
                </dd>
            </dl>
            @if (!Model.NameMatchesAtk)
            {
                <form method="post" asp-page-handler="UseAtkName" class="atk-name" data-new="1" data-confirm="Change the business name to “@Model.AtkName”? It is printed on every receipt from now on.">
                    <p class="small muted" style="margin: 0">ATK has a different name (@Model.AtkNameSource). Receipts should carry the name ATK has registered.</p>
                    <partial name="_ConfirmBox" model="@("Yes, use ATK's name")" />
                    <div class="actions" data-hide-on-confirm><button type="submit" class="btn small">Use ATK's name</button></div>
                </form>
            }
            <div class="tile-foot"><a class="btn small" href="/Settings/Business?Edit=true" data-dialog-open="dlg-business">Edit</a></div>
        </section>
        <section class="card">
            <h2>Unit (business premises)</h2>
            <dl class="kv">
                <dt>Unit</dt><dd><span class="mono">@b.BranchId</span>, @b.BranchName</dd>
                <dt>City</dt><dd>@b.Location</dd>
                <dt>OPERA property</dt><dd class="mono">@(string.IsNullOrEmpty(b.OperaHotelCode) ? "not set" : b.OperaHotelCode)</dd>
            </dl>
            <div class="tile-foot"><a class="btn small" href="/Settings/Business?Edit=true" data-dialog-open="dlg-business">Edit</a></div>
        </section>
    </div>
}
else
{
    <section class="card" style="max-width: 640px; display: flex; flex-direction: column; gap: 12px">
        <h2 style="margin: 0">The property is not set up yet</h2>
        <p style="margin: 0">This is the first step. Enter NUI, fiscalization number, unit number and Application ID as ATK issued them and validate them with ATK; the rest of the form then opens, with the registered name taken from ATK's answer.</p>
        <div><a class="btn primary" href="/Settings/Business?Edit=true" data-dialog-open="dlg-business">Set up the business</a></div>
    </section>
}

<dialog class="modal wide" id="dlg-business" aria-labelledby="dlg-business-title" data-autoopen="@(Model.Editing ? "1" : null)" open="@Model.Editing">
    <div class="modal-head"><h2 id="dlg-business-title">@(firstSetup ? "Set up the business" : "Edit business and unit")</h2><button type="button" class="modal-close" data-dialog-close data-return="/Settings/Business" aria-label="Close">×</button></div>
    <form method="post" asp-page="/Settings/Business" class="modal-body" id="business-form" data-confirm="@(firstSetup ? "Save the business and unit?" : "Save the business and unit? If NUI or unit number change, every workstation must be registered with ATK again.")" data-new="@(firstSetup ? "1" : null)">
        <div asp-validation-summary="All" class="validation"></div>
        <input type="hidden" asp-for="Validation">

        <h3 class="step-title"><span class="step-no">1</span> Issued by ATK</h3>
        <div class="form-grid">
            <label class="field">NUI (fiscal number) <input type="number" asp-for="Input.Nui" data-step1 data-before="@b?.Nui"></label>
            <label class="field">Fiscalization no. (from EDI) <input type="text" asp-for="Input.FiscalizationNo" data-step1 data-before="@b?.FiscalizationNo"></label>
            <label class="field">Unit number registered with ATK <input type="number" asp-for="Input.BranchId" data-step1 data-before="@b?.BranchId"></label>
            <label class="field">Application ID (from ATK) <input type="number" asp-for="Input.ApplicationId" min="1" value="@(Model.Input.ApplicationId > 0 ? Model.Input.ApplicationId.ToString() : "")" data-step1 data-before="@(b is null ? null : Model.ApplicationId.ToString())"></label>
        </div>
        <div class="validate-row">
            <label class="field pos">POS number for the check <input type="number" name="PosId" value="@(Model.PosId > 0 ? Model.PosId : Model.SuggestedPos)" min="1" aria-label="POS number for the check"></label>
            <button type="submit" class="btn" asp-page-handler="Validate" formnovalidate data-no-confirm>Validate with ATK (@(Model.AtkEnvironment == "Production" ? "Production" : "Test"))</button>
        </div>
        <p class="small muted" style="margin: 0">ATK's check needs a POS number that is not registered yet (the first free one is suggested). Nothing is registered: no key and no certificate are created.@(Model.AtkEnvironment == "Production" ? " In Production, use the POS number of the first workstation you will register." : "")</p>
        @if (Model.ValidationMessage is not null)
        {
            <div class="notice @(Model.ValidationFailed ? "bad" : "ok")" data-validation-msg>@Model.ValidationMessage</div>
        }

        <div id="step2" hidden="@(!Model.Step2Open)">
            <h3 class="step-title"><span class="step-no">2</span> Business and unit details</h3>
            <div class="form-grid">
                <label class="field">Registered name@(Model.Step1Validated ? " (from ATK)" : "") <input type="text" asp-for="Input.Name" data-before="@b?.Name"></label>
                <label class="field">VAT number <input type="text" asp-for="Input.VatNo" data-before="@b?.VatNo"></label>
                <label class="field">Unit name <input type="text" asp-for="Input.BranchName" data-before="@b?.BranchName"></label>
                <label class="field">City / location (printed) <input type="text" asp-for="Input.Location" data-before="@b?.Location"></label>
                <label class="field">Address <input type="text" asp-for="Input.Address" data-before="@b?.Address"></label>
                <label class="field">OPERA property code <input type="text" asp-for="Input.OperaHotelCode" data-before="@b?.OperaHotelCode"></label>
            </div>
            @if (b is not null)
            {
                <p class="small muted">Changing NUI or unit number: receipts already issued stay under the previous taxpayer, and every workstation must be registered with ATK again (their certificates name the NUI and unit).</p>
            }
            <partial name="_ConfirmBox" model="@("Yes, save")" />
            <div class="actions" data-hide-on-confirm><button type="submit" class="btn primary">Save</button><button type="button" class="btn" data-dialog-close data-return="/Settings/Business">Cancel</button></div>
        </div>
        <div id="step2-locked" class="step-locked" hidden="@Model.Step2Open">
            <p style="margin: 0"><span class="step-no muted-no">2</span> Business and unit details open after ATK confirms the values above.@(Model.ValidationFailed ? " If you are sure the values are right (for example ATK is not reachable), you can fill in the details without ATK's confirmation." : "")</p>
            <div class="actions">@if (Model.ValidationFailed) {<button type="button" class="btn" data-show-step2>Fill in the details anyway</button>}<button type="button" class="btn" data-dialog-close data-return="/Settings/Business">Cancel</button></div>
        </div>
    </form>
</dialog>
<script>
    // Step 1 changed after validation: the confirmation no longer applies, so step 2 closes until validated again.
    (function () {
        var form = document.getElementById('business-form');
        if (!form) return;
        var step1 = form.querySelectorAll('[data-step1]');
        var open = !document.getElementById('step2').hidden;
        function update() {
            var dirty = Array.prototype.some.call(step1, function (el) { return el.value !== el.defaultValue; });
            document.getElementById('step2').hidden = !open || dirty;
            document.getElementById('step2-locked').hidden = open && !dirty;
            var msg = form.querySelector('[data-validation-msg]');
            if (msg) msg.hidden = dirty;
        }
        step1.forEach(function (el) { el.addEventListener('input', update); });
        var anyway = form.querySelector('[data-show-step2]');
        if (anyway) anyway.addEventListener('click', function () { open = true; update(); });
    })();
</script>

@if (b is not null)
{
    <section class="card danger-zone">
        <h2>Start over with a new business</h2>
        <p style="margin: 0">Deletes the business, workstations, receipts, logs, FLIP messages, OPERA overrides and settings, so the application starts from zero for another taxpayer. Users, roles and VAT rates are kept.</p>
        @if (Model.ProductionUsed)
        {
            <div class="notice warn">Not possible here: this server has been connected to ATK <strong>Production</strong>. Receipts sent to Production are legal records that must be kept. For a new business, install the application with a new, empty database (installation manual).</div>
        }
        else
        {
            <p class="small muted" style="margin: 0">Only test data exists (ATK Test environment). Export what you want to keep first under <a href="/Export">Export</a>.</p>
            <div><a class="btn small danger" href="/Settings/Business?Reset=true">Start over…</a></div>
        }
    </section>

    @if (Model.Reset && !Model.ProductionUsed)
    {
        <dialog class="modal" id="dlg-reset" aria-labelledby="dlg-reset-title" data-autoopen="1" open>
            <div class="modal-head"><h2 id="dlg-reset-title">Start over with a new business</h2><button type="button" class="modal-close" data-dialog-close data-return="/Settings/Business" aria-label="Close">×</button></div>
            <form method="post" asp-page-handler="Reset" class="modal-body">
                <div asp-validation-summary="All" class="validation"></div>
                <div class="notice warn"><strong>This cannot be undone.</strong> All data of @b.Name (NUI @b.Nui) is deleted: @Model.Receipts receipt(s), @Model.Workstations workstation(s), the audit log, FLIP messages, OPERA overrides and settings. Users, roles and VAT rates stay.</div>
                <label class="field">Type the NUI <span class="mono">@b.Nui</span> to confirm <input type="text" name="confirmNui" autocomplete="off" inputmode="numeric" required></label>
                <div class="actions"><button type="submit" class="btn danger">Delete everything and start over</button><button type="button" class="btn" data-dialog-close data-return="/Settings/Business">Cancel</button></div>
            </form>
        </dialog>
    }
}
