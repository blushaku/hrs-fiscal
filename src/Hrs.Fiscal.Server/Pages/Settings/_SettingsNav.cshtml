@inject RolePermissions RolePerms
@using Microsoft.AspNetCore.Html
@{
    // Same header on every settings page: title, one-line tab bar, then the page's own intro (ViewData["SettingsIntro"]),
    // so the tabs never move when switching pages.
    var path = Context.Request.Path.Value ?? "";
    bool On(string p) => string.Equals(path, p, StringComparison.OrdinalIgnoreCase) || (p == "/Settings" && path.Equals("/Settings/Index", StringComparison.OrdinalIgnoreCase));
    var perms = await RolePerms.ForUserAsync(User);
    var tabs = new (string Href, string Label, string Perm)[]
    {
        ("/Settings", "General", Permissions.SettingsManage),
        ("/Settings/Business", "Business & unit", Permissions.SettingsManage),
        ("/Settings/Workstations", "Workstations", Permissions.WorkstationsManage),
        ("/Settings/Mapping", "OPERA overrides & VAT", Permissions.SettingsManage),
        ("/Settings/Users", "Users", Permissions.UsersManage),
        ("/Settings/Roles", "Roles & permissions", Permissions.UsersManage),
    };
    var intro = ViewData["SettingsIntro"];
}
<div class="page-head"><div><h1>Settings</h1></div></div>
<nav class="settings-tabs" aria-label="Settings sections">
    @foreach (var t in tabs.Where(t => perms.Contains(t.Perm)))
    {
        <a href="@t.Href" class="@(On(t.Href) ? "on" : null)" aria-current="@(On(t.Href) ? "page" : null)">@t.Label</a>
    }
</nav>
<p class="small muted settings-intro">
    @if (intro is IHtmlContent html) { @html } else if (intro is string s && s.Length > 0) { @s }
    @(intro is null ? "" : " ")Every change is recorded in the audit log with its old and new value.
</p>
