@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<form method="post" class="login-card">
    <div style="display: flex; flex-direction: column; gap: 12px">
        <img class="login-logo" src="~/img/hrs-logo.svg" alt="HRS Hospitality &amp; Retail Systems">
        <div>
            <h1 style="font-size: 22px">@AppVersion.ProductName</h1>
            <p class="muted small" style="margin: 2px 0 0">Kosovo fiscalization (SEF) · administration</p>
        </div>
    </div>
    @if (Model.Error is not null)
    {
        <div class="notice bad" role="alert">@Model.Error</div>
    }
    <label class="field">Username
        <input type="text" asp-for="Username" autocomplete="username" required autofocus>
    </label>
    <label class="field">Password
        <input type="password" asp-for="Password" autocomplete="current-password" required>
    </label>
    <input type="hidden" asp-for="ReturnUrl">
    <button type="submit" class="btn primary">Sign in</button>
    <p class="small muted" style="margin: 0; text-align: center">@AppVersion.ProductName @AppVersion.Version</p>
</form>
