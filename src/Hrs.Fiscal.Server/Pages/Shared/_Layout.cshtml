@inject SettingsStore Settings
@inject RolePermissions RolePerms
@{
    var path = Context.Request.Path.Value ?? "/";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var perms = await RolePerms.ForUserAsync(User);
    bool Can(string p) => perms.Contains(p);
    // Settings opens on the first section this user may manage.
    var settingsHref = Can(Permissions.SettingsManage) ? "/Settings" : Can(Permissions.WorkstationsManage) ? "/Settings/Workstations" : Can(Permissions.UsersManage) ? "/Settings/Users" : null;
    var business = signedIn ? await Settings.BusinessAsync() : null;
    bool On(string prefix) => prefix == "/" ? path == "/" : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
    var environment = signedIn ? await Settings.GetAsync("atk_environment", "Test") ?? "Test" : "Test";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · @AppVersion.ProductName</title>
    <link rel="icon" type="image/png" href="~/favicon.png">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
@if (!signedIn)
{
    <main class="login-shell">@RenderBody()</main>
}
else
{
    <header class="bar">
        <div class="bar-inner">
            <a class="brand" href="/" aria-label="@AppVersion.ProductName — dashboard">
                <img src="~/img/mark.svg" alt="">
                <div><div class="name">Opera Cloud Fiscal Solution</div><div class="sub">Kosovo SEF · @(business is null ? "property not set up" : $"{business.BranchName}, unit {business.BranchId}")</div></div>
            </a>
            <div class="who">
                <span class="env @(environment == "Production" ? "prod" : "")">@(environment == "Production" ? "PRODUCTION" : "TEST")</span>
                <span><b>@User.Display()</b> · @User.Role()</span>
                <form method="post" action="/logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn sm">Sign out</button>
                </form>
            </div>
        </div>
    </header>
    <div class="stripe">
        <nav class="tabs" aria-label="Main">
            <a href="/" aria-current="@(On("/") ? "page" : null)">Dashboard</a>
            @if (Can(Permissions.ReceiptsView)) { <a href="/Receipts" aria-current="@(On("/Receipts") ? "page" : null)">Receipts</a> }
            @if (Can(Permissions.FlipView)) { <a href="/FlipMessages" aria-current="@(On("/FlipMessages") ? "page" : null)">FLIP messages</a> }
            @if (Can(Permissions.AuditView)) { <a href="/Audit" aria-current="@(On("/Audit") ? "page" : null)">Audit log</a> }
            @if (Can(Permissions.Export)) { <a href="/Export" aria-current="@(On("/Export") ? "page" : null)">Export</a> }
            @if (settingsHref is not null) { <a href="@settingsHref" aria-current="@(On("/Settings") ? "page" : null)">Settings</a> }
        </nav>
    </div>
    <div class="shell">
        <main class="content">
            @if (TempData["Message"] is string msg)
            {
                <div class="notice ok" role="status">@msg</div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="notice warn" role="alert">@err</div>
            }
            @RenderBody()
        </main>
        <footer class="foot">
            <img src="~/img/logo.svg" alt="@AppVersion.ProductName">
            <span title="Build @AppVersion.Commit">@AppVersion.ProductName @AppVersion.Version · Developer: @AppVersion.Developer</span>
        </footer>
    </div>
}
</body>
</html>
