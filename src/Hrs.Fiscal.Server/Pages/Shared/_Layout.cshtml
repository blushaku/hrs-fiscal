@inject SettingsStore Settings
@inject RolePermissions RolePerms
@{
    var path = Context.Request.Path.Value ?? "/";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var perms = await RolePerms.ForUserAsync(User);
    bool Can(string p) => perms.Contains(p);
    // Settings opens on the first section this user may manage.
    var settingsHref = Can(Permissions.SettingsManage) ? "/Settings" : Can(Permissions.WorkstationsManage) ? "/Settings/Workstations" : Can(Permissions.UsersManage) ? "/Settings/Users" : null;
    var business = signedIn ? await Settings.BusinessAsync() : null;
    static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    string Active(string prefix) => (prefix == "/" ? path == "/" : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) ? "nav-link active" : "nav-link";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · HRS Fiscal</title>
    <link rel="icon" type="image/png" href="~/favicon.png">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
@if (!signedIn)
{
    <main class="login-shell">@RenderBody()</main>
}
else
{
    <header class="suitebar">
        <a class="suite-app" href="/" aria-label="HRS Fiscal — dashboard"><span class="suite-mark" aria-hidden="true">HRS</span>Fiscal <span class="suite-sub">Kosovo SEF</span></a>
        <span class="suite-property">@(business is null ? "Property not set up" : $"{business.BranchName} · Unit {business.BranchId}")</span>
        <div class="suite-right">
            <span class="suite-user" title="@User.Role()"><span class="suite-avatar" aria-hidden="true">@Initials(User.Display())</span><span class="who">@User.Display()</span></span>
            <form method="post" action="/logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="link-button">Sign out</button>
            </form>
        </div>
    </header>
    <div class="shell">
        <nav class="sidebar" aria-label="Main">
            <div class="brand">
                <a href="/" aria-label="HRS Fiscal — dashboard"><img class="brand-logo" src="~/img/hrs-logo.svg" alt="HRS Hospitality &amp; Retail Systems"></a>
            </div>
            <div class="nav">
                <a class="@Active("/")" href="/">Dashboard</a>
                @if (Can(Permissions.ReceiptsView)) { <a class="@Active("/Receipts")" href="/Receipts">Receipts</a> }
                @if (Can(Permissions.AuditView)) { <a class="@Active("/Audit")" href="/Audit">Audit log</a> }
                @if (Can(Permissions.Export)) { <a class="@Active("/Export")" href="/Export">Export</a> }
                @if (Can(Permissions.FlipView)) { <a class="@Active("/FlipMessages")" href="/FlipMessages">FLIP messages</a> }
                @if (settingsHref is not null) { <a class="@Active("/Settings")" href="@settingsHref">Settings</a> }
            </div>
            <div class="sidebar-foot">
                <div>@User.Role()</div>
                <div class="version" title="Build @AppVersion.Commit">HRS Fiscal @AppVersion.Version</div>
            </div>
        </nav>
        <main class="content">
            @if (TempData["Message"] is string msg)
            {
                <div class="notice ok" role="status">@msg</div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="notice warn" role="alert">@err</div>
            }
            @RenderBody()
        </main>
    </div>
}
</body>
</html>
