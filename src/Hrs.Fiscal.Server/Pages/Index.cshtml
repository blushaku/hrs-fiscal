@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var s = Model.Stats;
}
<div class="page-head">
    <div>
        <h1>Today</h1>
        <p>@Model.Clock.LocalNow.ToString("dddd dd.MM.yyyy") · @(Model.Business?.BranchName ?? "property not set up")</p>
    </div>
    <a class="btn primary" href="/Receipts">Search receipts</a>
</div>

@if (Model.Business is null)
{
    <div class="notice warn">The property is not set up yet. An administrator must enter the business and unit details under <a href="/Settings/Business">Settings › Business</a>.</div>
}

<div class="tiles">
    <div class="tile">
        <div class="label">Receipts issued</div>
        <div class="value">@s.IssuedToday</div>
        <div class="sub">@Fmt.Eur(s.TotalTodayCents) total</div>
    </div>
    <div class="tile">
        <div class="label">Accepted by ATK</div>
        <div class="value" style="color: var(--accent)">@s.AcceptedToday</div>
        <div class="sub">today</div>
    </div>
    <div class="tile @(s.Pending > 0 ? "warn" : "")">
        <div class="label">Waiting to send</div>
        <div class="value">@s.Pending</div>
        <div class="sub">
            @if (s.OldestPendingIssuedAt is { } oldest)
            {
                <text>oldest @Model.Clock.FormatShort(oldest) · 48 h deadline @Model.Clock.FormatShort(oldest.AddHours(48))</text>
            }
            else
            {
                <text>nothing pending</text>
            }
        </div>
    </div>
    <div class="tile">
        <div class="label">Rejected</div>
        <div class="value">@s.RejectedToday</div>
        <div class="sub">last 30 days: @s.Rejected30Days</div>
    </div>
</div>

<div class="grid">
    <section class="card">
        <h2>Workstations</h2>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Terminal</th><th>POS ID</th><th>Status</th><th>Last receipt</th><th>Certificate</th></tr></thead>
                <tbody>
                @foreach (var t in Model.Terminals)
                {
                    var days = t.CertificateExpires is { } exp ? (int)(exp - Model.UtcNow).TotalDays : (int?)null;
                    <tr>
                        <td>@t.Label</td>
                        <td class="mono">@t.PosId</td>
                        <td>
                            @if (t.Status != "active") { <span class="badge neutral">@t.Status</span> }
                            else if (t.PendingCount > 0) { <span class="badge pending">@t.PendingCount waiting</span> }
                            else { <span class="badge accepted">OK</span> }
                        </td>
                        <td>@(t.LastReceiptAt is { } l ? Model.Clock.FormatShort(l) : "—")</td>
                        <td>
                            @if (days is null) { <span class="muted">not enrolled</span> }
                            else if (days < 30) { <strong style="color: var(--pending-ink)">expires in @days days</strong> }
                            else { <text>valid to @Model.Clock.ToLocal(t.CertificateExpires!.Value).ToString("MM.yyyy")</text> }
                        </td>
                    </tr>
                }
                @if (Model.Terminals.Count == 0)
                {
                    <tr><td colspan="5" class="muted">No workstations registered.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
    <section class="card" style="display: flex; flex-direction: column; gap: 12px">
        <h2 style="margin: 0">Alerts</h2>
        @if (s.Overdue48h > 0)
        {
            <div class="notice bad"><strong>@s.Overdue48h receipt(s) are past the 48-hour deadline.</strong> Notify ATK of the outage and submit them by the 10th of next month at the latest.</div>
        }
        @if (s.Pending > 0)
        {
            <div class="notice warn"><strong>@s.Pending receipt(s) not yet sent to ATK.</strong> They were issued marked OFFLINE and are sent automatically when the connection returns. <a href="/Receipts?Status=pending">Show them</a>.</div>
        }
        @foreach (var t in Model.Terminals.Where(t => t.CertificateExpires is { } e && (e - Model.UtcNow).TotalDays < 30))
        {
            <div class="notice neutral"><strong>Certificate renewal</strong> needed for @t.Label within @((int)(t.CertificateExpires!.Value - Model.UtcNow).TotalDays) days.</div>
        }
        @if (s.Pending == 0 && s.Overdue48h == 0 && !Model.Terminals.Any(t => t.CertificateExpires is { } e && (e - Model.UtcNow).TotalDays < 30))
        {
            <div class="notice ok">No alerts. All receipts are fiscalized.</div>
        }
    </section>
</div>
