@page
@model IndexModel
@inject RolePermissions RolePerms
@{
    var perms = await RolePerms.ForUserAsync(User);
    var system = perms.Contains(Permissions.DashboardSystem);
    var canReceipts = perms.Contains(Permissions.ReceiptsView);
    ViewData["Title"] = "Dashboard";
    var s = Model.Stats;
    var live = Model.FlipMode == "live";
    var ready = Model.Terminals.Count(t => t.Status == "active");
    var expiring = Model.Terminals.Where(t => t.CertificateExpires is { } e && (e - Model.UtcNow).TotalDays < 30).ToList();
}
<div class="page-head">
    <div>
        <h1>Today</h1>
        <p>@Model.Clock.LocalNow.ToString("dddd, dd.MM.yyyy") — @(Model.Business?.BranchName ?? "property not set up")</p>
    </div>
    <div class="actions" style="align-items: center">
        <span class="small muted">Updated @Model.Clock.LocalNow.ToString("HH:mm:ss")</span>
        <a class="btn" href="/" aria-label="Refresh the dashboard">Refresh</a>
        @if (canReceipts) { <a class="btn primary" href="/Receipts">Search receipts</a> }
    </div>
</div>

@if (Model.Business is null && system)
{
    <div class="notice warn">The property is not set up yet. An administrator must enter the business and unit details under <a href="/Settings/Business">Settings › Business</a>.</div>
}

@if (system)
{
<section class="tile-ink" aria-labelledby="flow-title">
    <h2 id="flow-title" style="margin: 0">How folios reach ATK</h2>
    <p class="small" style="margin: 4px 0 0">@(live ? "Live: every OPERA folio is fiscalized." : "Capture: FLIP messages are recorded but not fiscalized.") ATK @Model.AtkEnvironment.ToLowerInvariant() environment.</p>
    <div class="flow">
        <div class="stage">
            <div class="name">OPERA</div>
            <div class="state"><span class="dot @(Model.FlipToday > 0 ? "" : "idle")"></span>@Model.FlipToday folio message(s) today</div>
        </div>
        <div class="stage">
            <div class="name">FLIP</div>
            <div class="state"><span class="dot @(Model.LastFlipAt is null ? "idle" : Model.LastFlipMode == "rejected" ? "warn" : "")"></span>last call @Model.Ago(Model.LastFlipAt)@(Model.LastFlipMode == "rejected" ? " (refused: token)" : "")</div>
        </div>
        <div class="stage">
            <div class="name">HRS Fiscal</div>
            <div class="state"><span class="dot @(live && ready > 0 ? "" : live ? "warn" : "idle")"></span>@(live ? "live" : "capture") · @ready of @Model.Terminals.Count workstation(s) ready</div>
        </div>
        <div class="stage">
            <div class="name">ATK</div>
            <div class="state"><span class="dot @(s.Pending > 0 ? "warn" : Model.LastAcceptedAt is null ? "idle" : "")"></span>@(s.Pending > 0 ? $"{s.Pending} waiting to send" : $"last accepted {Model.Ago(Model.LastAcceptedAt)}")</div>
        </div>
    </div>
</section>
}
else if (canReceipts)
{
    <form method="get" action="/Receipts" class="tile-ink" role="search" style="display: flex; flex-direction: column; gap: 12px">
        <h2 style="margin: 0">Find a receipt</h2>
        <div style="display: flex; gap: 10px; flex-wrap: wrap; position: relative; z-index: 1">
            <label class="sr-only" for="find-q">Receipt no., NUIKF, folio or cashier</label>
            <input id="find-q" type="search" name="Q" placeholder="Receipt no., NUIKF, folio or cashier" style="flex: 1 1 260px">
            <button type="submit" class="btn primary">Search</button>
        </div>
    </form>
}

<div class="tiles">
    <div class="tile">
        <div class="label">Receipts issued</div>
        <div class="value">@s.IssuedToday</div>
        <div class="sub">@Fmt.Eur(s.TotalTodayCents) total</div>
    </div>
    <div class="tile">
        <div class="label">Accepted by ATK</div>
        <div class="value">@s.AcceptedToday</div>
        <div class="sub">today</div>
    </div>
    <a class="tile @(s.Pending > 0 ? "warn" : "")" href="@(canReceipts ? "/Receipts?Status=pending" : "#")" style="text-decoration: none">
        <div class="label">Waiting to send</div>
        <div class="value">@s.Pending</div>
        <div class="sub">
            @if (s.OldestPendingIssuedAt is { } oldest)
            {
                <text>oldest @Model.Clock.FormatShort(oldest), deadline @Model.Clock.FormatShort(oldest.AddHours(48))</text>
            }
            else
            {
                <text>nothing pending</text>
            }
        </div>
    </a>
    <div class="tile">
        <div class="label">Rejected</div>
        <div class="value">@s.RejectedToday</div>
        <div class="sub">last 30 days: @s.Rejected30Days</div>
    </div>
</div>

<div class="grid">
    <section class="card @(system ? "span-2" : "span-all")">
        <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap">
            <h2>Workstations</h2>
            @if (perms.Contains(Permissions.WorkstationsManage)) { <a class="small" href="/Settings/Workstations">Manage</a> }
        </div>
        <div class="ws-grid" style="grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 12px">
            @foreach (var t in Model.Terminals)
            {
                var days = t.CertificateExpires is { } exp ? (int)(exp - Model.UtcNow).TotalDays : (int?)null;
                <div class="notice" style="display: flex; flex-direction: column; gap: 4px">
                    <div style="display: flex; justify-content: space-between; gap: 8px; align-items: center">
                        @if (canReceipts) { <a href="/Receipts?Terminal=@t.Id" style="font-weight: 500; color: var(--hrs-navy)">@(t.OperaTerminalId ?? t.Hostname)</a> } else { <span style="font-weight: 500; color: var(--hrs-navy)">@(t.OperaTerminalId ?? t.Hostname)</span> }
                        @if (t.Status != "active") { <span class="badge neutral">@t.Status</span> }
                        else if (t.PendingCount > 0) { <span class="badge pending">@t.PendingCount waiting</span> }
                        else { <span class="badge accepted">OK</span> }
                    </div>
                    <span class="small muted">POS @t.PosId, @t.Hostname</span>
                    <span class="small">Last receipt @(t.LastReceiptAt is { } l ? Model.Clock.FormatShort(l) : "none yet")</span>
                    <span class="small">
                        @if (days is null) { <span class="muted">Not registered with ATK</span> }
                        else if (days < 30) { <strong style="color: var(--pending-ink)">Certificate expires in @days days</strong> }
                        else { <text>Certificate valid to @Model.Clock.ToLocal(t.CertificateExpires!.Value).ToString("MM.yyyy")</text> }
                    </span>
                </div>
            }
            @if (Model.Terminals.Count == 0)
            {
                <a class="ws add card" href="/Settings/Workstations?Add=true" style="min-height: 120px"><span class="plus" aria-hidden="true">+</span>Add the first workstation</a>
            }
        </div>
    </section>
    @if (system)
    {
    <section class="card" style="display: flex; flex-direction: column; gap: 12px">
        <h2 style="margin: 0">Alerts</h2>
        @if (s.Overdue48h > 0)
        {
            <div class="notice bad"><strong>@s.Overdue48h receipt(s) are past the 48-hour deadline.</strong> Notify ATK of the outage and submit them by the 10th of next month at the latest.</div>
        }
        @if (s.Pending > 0)
        {
            <div class="notice warn"><strong>@s.Pending receipt(s) not yet sent to ATK.</strong> They are sent automatically when the connection returns. <a href="/Receipts?Status=pending">Show them</a>.</div>
        }
        @foreach (var t in expiring)
        {
            <div class="notice neutral"><strong>Certificate renewal</strong> needed for @t.Label within @((int)(t.CertificateExpires!.Value - Model.UtcNow).TotalDays) days.</div>
        }
        @if (s.Pending == 0 && s.Overdue48h == 0 && expiring.Count == 0)
        {
            <div class="notice ok">No alerts. All receipts are fiscalized.</div>
        }
    </section>
    }
</div>
