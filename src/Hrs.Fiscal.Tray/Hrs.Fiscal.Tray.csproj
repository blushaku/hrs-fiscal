<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tray program of the Fiscal Client: the offline notice at the workstation. .NET Framework 4.8 is part of
       Windows 10/11, so it needs no runtime, starts for every user at logon and only reads http://localhost:5110/status. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Hrs.Fiscal.Tray</RootNamespace>
    <AssemblyName>Hrs.Fiscal.Tray</AssemblyName>
    <Product>Opera Cloud Fiscal Solution - Kosovo</Product>
    <AssemblyTitle>Fiscal Client - status</AssemblyTitle>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
